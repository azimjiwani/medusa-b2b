# Core Medusa configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-b2b
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-value
COOKIE_SECRET=replace-with-a-long-random-value

# Local application URLs and CORS origins
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_STOREFRONT_URL=http://localhost:8000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Transactional email (https://resend.com)
# Create a sending API key in Resend. Never commit the real value.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# The address must use a domain verified in Resend. A display name is supported.
RESEND_FROM=Medusa B2B <noreply@example.com>
# Optional address for customer replies.
RESEND_REPLY_TO=support@example.com

# Optional comma-separated BCC lists. Leave the value empty to disable a list.
EMAIL_ORDER_BCC=info@bntbng.com,bntwarehouse@rogers.com
EMAIL_WELCOME_BCC=info@bntbng.com,bntwarehouse@rogers.com
EMAIL_APPROVAL_BCC=info@bntbng.com
